[Ll]ogs/

# --- Outils d'assistance (Claude Code, Impeccable) ---------------------------
# Réglages personnels de Claude Code (permissions accordées sur ce poste).
.claude/settings.local.json
# Binaire de l'outil Impeccable, téléchargé au premier lancement (~15 Mo, propre à l'OS).
.claude/skills/impeccable/scripts/bin/
# Artefacts de travail d'Impeccable : pages de décision, captures de relecture,
# maquettes et réglages locaux. Le contexte durable (surfaces/, design.json,
# live/config.json, config.json) reste versionné.
.impeccable/questions/
.impeccable/review/
.impeccable/mocks/
.impeccable/build/
.impeccable/live/inject-journal.json
.impeccable/config.local.json

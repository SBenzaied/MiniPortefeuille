# =============================================================================
# Mini-portefeuille : fichiers générés, locaux ou sensibles à ne pas versionner.
# =============================================================================

# --- Secrets et configuration locale -----------------------------------------
# .env contient la clé JWT et le mot de passe de la base ; seul le modèle est versionné.
.env
.env.*
!.env.example
appsettings.*.local.json
*.pfx
*.p12
*.key

# --- .NET : sorties de build et de restauration ------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
*.binlog
*.nupkg
*.snupkg
project.lock.json

# --- .NET : tests et couverture ----------------------------------------------
[Tt]est[Rr]esult*/
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
nunit-*.xml
TestResult.xml

# --- Bases SQLite locales (portfolio-dev.db, créée au démarrage) --------------
*.db
*.db-shm
*.db-wal
*.sqlite

# --- Front (src/web) ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/
coverage/
.eslintcache
.oxlintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Sorties éventuelles de Playwright (les captures du README, elles, sont versionnées).
playwright-report/
test-results/

# --- Docker ------------------------------------------------------------------
docker-compose.override.yml

